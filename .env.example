# Copy to .env locally. Never commit real values.
# Generate a fresh shared token locally: python -c "import secrets; print(secrets.token_hex(32))"
JARVIS_AUTH_TOKEN=""
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8765
CLOUD_URL=http://127.0.0.1:8765
CLOUD_ENABLED=false
CLOUD_ALLOWED_ORIGINS=""
# Electron creates an isolated local session token; only set this for manual startup.
JARVIS_LOCAL_AUTH_TOKEN=""
# VM listening address, only when intentionally hosting behind a firewall/TLS proxy.
# CLOUD_HOST=0.0.0.0

GROQ_API_KEY_1=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_API_KEY_4=""
GROQ_API_KEY_5=""
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""
GEMINI_API_KEY_6=""
GEMINI_API_KEY_7=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_USERNAME=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
USER_PHONE_NUMBER=""
TWILIO_WEBHOOK_BASE=""
# Optional explicit first-boot shutdown password; no built-in password is used.
SHUTDOWN_PASSWORD=""
# Installer only: use a token with the minimum repository Actions read access.
GITHUB_TOKEN=""
GITHUB_REPOSITORY=""
ADB_DEVICE_SERIAL=""
